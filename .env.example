# -----------------------------------------------
# APPLICATION
# -----------------------------------------------
LANGUAGE=de
DASHBOARD_PORT=5028
DASHBOARD_BASE_PATH=/dashboardheizung
INTERVALL=60

# APP_MODE: production = echte Heizungsdaten, simulate = nur Dashboard mit DB-Daten
APP_MODE=production

# Logging
LOG_LEVEL=INFO
LOG_MODE=console
LOG_FILE=heizung.log
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=3
LOGGING_ON=true
SAVE_SNAPSHOTS=false

# History CSV (wöchentliche Dateien für Replay)
SAVE_HISTORY=true
HISTORY_DIR=./data/history
HISTORY_KEEP_WEEKS=8

# -----------------------------------------------
# MQTT BROKER (optional – leer lassen = deaktiviert)
# -----------------------------------------------
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_KEEPALIVE=60
MQTT_CLIENTID=heizungscontroller

# MQTT Topics
MQTT_TOPIC_STATUS=logamax/status
MQTT_TOPIC_BOILER=logamax/boiler
MQTT_TOPIC_DHW=logamax/dhw
MQTT_TOPIC_HEATING=logamax/heating
MQTT_TOPIC_ENERGY=logamax/energy
MQTT_TOPIC_COSTS=logamax/costs
MQTT_TOPIC_GAS=logamax/gas
MQTT_TOPIC_RAW=logamax/rawdata

# -----------------------------------------------
# Heizung Buderus LOGAMAX PLUS GB172-14
# -----------------------------------------------
HEATING_ID=LOGAMAX
HEATING_NAME=Heizungsanlage 2021
HEATING_MANUFACTURER=Buderus
HEATING_MODEL=Buderus LOGAMAX PLUS GB172-14
HEATING_SOFTWARE=2.0.0
HEATING_INSTALLED=2021-06-06 12:00:00

# API Endpunkte (EMS-ESP32)
HEATING_SENSOR=http://ems-heizung.siebler.home/api/boiler
HEATING_THERMOSTAT=http://ems-heizung.siebler.home/api/thermostat
HEATING_INFO=http://ems-heizung.siebler.home/api/system/info

# Intervalle
FAST_INTERVAL=10
SLOW_INTERVAL=300
GAS_TTL=30
SYSTEM_CACHE_TTL=3600

# -----------------------------------------------
# GASMETER ESP32 (Sensor-URL + Index-Konfiguration)
# -----------------------------------------------
GASMETER_SENSOR=http://10.1.1.246/text_sensor/gasmeterdata
GASMETER_DISPLAY=0
GASMETER_M3=1
GASMETER_TS=2

# -----------------------------------------------
# Home Assistant (optional – leer lassen = deaktiviert)
# -----------------------------------------------
HA_DISCOVERY=false
HA_PREFIX=logamax
HA_DISCOVERY_PREFIX=homeassistant
HA_DATADIR=./data/homeassistant/
HA_WEBHOOK_URL=
HA_WEBHOOK_ID=
